<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Google Drive and Play services use HTTPS. Local pairing uses raw WebSockets, not cleartext HTTP. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
