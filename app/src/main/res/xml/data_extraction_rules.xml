        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="backup_credentials.xml" />
        <exclude domain="file" path="sync-peer-keys.bin" />
        <exclude domain="file" path="room-passphrase.bin" />
    </device-transfer>
</data-extraction-rules>
