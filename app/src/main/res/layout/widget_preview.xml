<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_preview_hero_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/onest"
            android:includeFontPadding="false"
            android:text="@string/home_brand"
            android:textColor="@color/widget_preview_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_preview_plus_bg"
            android:contentDescription="@string/widget_add_debt"
            android:fontFamily="@font/onest"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/widget_plus"
            android:textColor="@color/widget_preview_on_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/onest"
            android:includeFontPadding="false"
            android:text="@string/debt_dashboard_owes_me"
            android:textColor="@color/widget_preview_muted"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/onest"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_owes"
            android:textColor="@color/widget_preview_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/onest"
            android:includeFontPadding="false"
            android:text="@string/debt_dashboard_i_owe"
            android:textColor="@color/widget_preview_muted"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/onest"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_i_owe"
            android:textColor="@color/widget_preview_negative"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/onest"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_preview_goal_name"
        android:textColor="@color/widget_preview_on_card"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/onest"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_goal_ratio"
            android:textColor="@color/widget_preview_muted"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/onest"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_goal_percent"
            android:textColor="@color/widget_preview_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:indeterminate="false"
        android:max="100"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:progress="33"
        android:progressDrawable="@drawable/widget_preview_progress" />
</LinearLayout>
