<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="156dp"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/onest"
            android:includeFontPadding="false"
            android:text="@string/home_brand"
            android:textColor="@color/widget_preview_on_card"
            android:textSize="18sp" />

        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_preview_plus_bg"
            android:contentDescription="@string/widget_add_debt"
            android:fontFamily="@font/onest"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/widget_plus"
            android:textColor="@color/widget_preview_on_mint"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/onest"
                android:includeFontPadding="false"
                android:text="@string/debt_dashboard_owes_me"
                android:textColor="@color/widget_preview_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/onest"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_owes"
                android:textColor="@color/widget_preview_primary"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/onest"
                android:gravity="end"
                android:includeFontPadding="false"
                android:text="@string/debt_dashboard_i_owe"
                android:textColor="@color/widget_preview_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/onest"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_i_owe"
                android:textColor="@color/widget_preview_negative"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_goal_flag" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/onest"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_goal_name"
            android:textColor="@color/widget_preview_on_card"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/onest"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_goal_ratio"
            android:textColor="@color/widget_preview_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/onest"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_meter_separator"
            android:textColor="@color/widget_preview_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/onest"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_goal_percent"
            android:textColor="@color/widget_preview_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:indeterminate="false"
        android:max="100"
        android:maxHeight="8dp"
        android:minHeight="8dp"
        android:progress="33"
        android:progressDrawable="@drawable/widget_preview_progress" />
</LinearLayout>
